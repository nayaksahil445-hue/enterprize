# Google Search Console site verification token for the production build
VITE_GOOGLE_SITE_VERIFICATION=YOUR_VERIFICATION_TOKEN

# (Optional) Comma-separated list of allowed origins for CORS. Example:
# ALLOWED_ORIGINS=https://enterprize-sand.vercel.app,https://admin.yourdomain.com
# If empty, server will allow all origins (backwards compatible).
ALLOWED_ORIGINS=

# Google OAuth Client ID (frontend) - optional: enables Google Sign-In
# VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# Google Client ID for server verification (set on backend platform as GOOGLE_CLIENT_ID)
# GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

